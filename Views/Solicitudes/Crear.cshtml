@model GestionCreditos.Models.ViewModels.CrearSolicitudViewModel
@{
    ViewData["Title"] = "Nueva solicitud de crédito";
}

<h1>Nueva solicitud de crédito</h1>

<form method="post" asp-action="Crear" class="border rounded p-3 mt-3 bg-light" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="MontoSolicitado" class="form-label"></label>
        <input asp-for="MontoSolicitado" class="form-control" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar solicitud</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}