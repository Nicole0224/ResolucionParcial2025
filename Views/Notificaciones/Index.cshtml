@model List<GestionCreditos.Models.Notificacion>
@{
    ViewData["Title"] = "Mis notificaciones";
}

<h1>Mis notificaciones</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No tienes notificaciones.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Mensaje</th>
                <th>Solicitud</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.FechaProcesamientoUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                    <td>@n.Texto</td>
                    <td>
                        <a asp-controller="Solicitudes" asp-action="Details" asp-route-id="@n.SolicitudId">#@n.SolicitudId</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
